<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Kursova.MainPage"
             Title="">

    <Grid>
        <!-- Фонова картинка -->
        <Image Source="background.png"
               Aspect="AspectFill"
               HorizontalOptions="FillAndExpand"
               VerticalOptions="FillAndExpand" />

        <!-- Основний контент -->
        <Grid x:Name="InitialInterface" Padding="20">

            <!-- Напис SIMPLE WAY -->
            <Grid HorizontalOptions="Center"
                  VerticalOptions="Start"
                  Margin="0,150,0,0">
                <!-- Контур -->
                <Label Text="SIMPLE WAY"
                       FontSize="70"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       TextColor="Red"
                       Padding="1,1,1,1" />

                <!-- Текст -->
                <Label Text="SIMPLE WAY"
                       FontSize="70"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       TextColor="White" />
            </Grid>

            <!-- Кнопка Розпочати подорож -->
            <Button x:Name="StartButton"
                    Text="Розпочати подорож"
                    BackgroundColor="LightGray"
                    TextColor="Black"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="250"
                    HeightRequest="100"
                    CornerRadius="20"
                    Clicked="OnStartButtonClicked">
                <Button.Triggers>
                    <Trigger TargetType="Button" Property="IsPressed" Value="True">
                        <Setter Property="Scale" Value="1.1" />
                    </Trigger>
                </Button.Triggers>
            </Button>




            <!-- Блок новин -->
            <Frame BackgroundColor="White"
                   Padding="10"
                   CornerRadius="10"
                   HorizontalOptions="Start"
                   VerticalOptions="End"
                   WidthRequest="300"
                   HeightRequest="350"
                   Opacity="0.8"
                   Margin="10">
                <StackLayout>
                    <Label Text="Новини з України"
                           HorizontalOptions="CenterAndExpand"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="Black" />

                    <Label Text="{Binding CurrentNews.Title}"
                           FontSize="14"
                           TextColor="Black"
                           FontAttributes="Bold" />

                    <Label Text="{Binding CurrentNews.Description}"
                           FontSize="12"
                           TextColor="Black" />

                    <Label Text="{Binding CurrentNews.Source}"
                           FontSize="10"
                           TextColor="Black"
                           FontAttributes="Italic"
                           HorizontalOptions="End" />

                    <!-- Індикатор для перемикання між новинами -->
                    <IndicatorView x:Name="NewsIndicator"
                                  IndicatorColor="Gray"
                                  SelectedIndicatorColor="Black"
                                  HorizontalOptions="CenterAndExpand"
                                  VerticalOptions="EndAndExpand"
                                  IndicatorSize="10"
                                  Count="{Binding NewsCount}"
                                  Position="{Binding CurrentNewsIndex, Mode=TwoWay}" />
                </StackLayout>
            </Frame>

            <!-- Блок часу і місцезнаходження праворуч -->
            <Frame BackgroundColor="White"
                   Padding="10"
                   CornerRadius="10"
                   HorizontalOptions="End"
                   VerticalOptions="End"
                   WidthRequest="100"
                   HeightRequest="100"
                   Opacity="0.8"
                   Margin="10">
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Київ"
                           FontAttributes="Bold"
                           FontSize="20"
                           TextColor="Black"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Label Text="{Binding CurrentTime}"
                           FontSize="18"
                           TextColor="Black"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </StackLayout>
            </Frame>

        </Grid>

        <!-- Інтерфейс з картою -->
        <Grid x:Name="MapInterface" IsVisible="False">
            <!-- Заднє розмите зображення -->
            <Image x:Name="BlurredBackground"
                   Source="background2.png"
                   Aspect="AspectFill"
                   HorizontalOptions="FillAndExpand"
                   VerticalOptions="FillAndExpand" />

            <!-- Поля вводу та карта -->
            <Grid Padding="20">
                <!-- Поля вводу -->
                <Grid VerticalOptions="Start">
                    <StackLayout Orientation="Horizontal" Spacing="20">
                        <StackLayout>
                            <Label Text="Точка відправлення"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"
                                   TextColor="Black" />
                            <Entry x:Name="StartPointEntry"
                                   Placeholder="Введіть адресу відправлення"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Start"/>
                        </StackLayout>

                        <StackLayout>
                            <Label Text="Точка прибуття"
                                   FontAttributes="Bold"
                                   TextColor="Black" 
                                   HorizontalOptions="End"
                                   VerticalOptions="Start"/>
                            <Entry x:Name="DestinationPointEntry"
                                   Placeholder="Введіть адресу прибуття"
                                   HorizontalOptions="End"
                                   VerticalOptions="Start"/>
                        </StackLayout>
                    </StackLayout>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>