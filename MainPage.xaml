<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Kursova.Converters"
             x:Class="Kursova.MainPage"
             Title="">

    <!-- Ресурси сторінки -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <local:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
            <local:AvailabilityConverter x:Key="AvailabilityConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Основний контент -->
        <Grid x:Name="InitialInterface">

            <!-- Фонова картинка -->
            <Image Source="background.png"
                   Aspect="AspectFill"
                   HorizontalOptions="FillAndExpand"
                   VerticalOptions="FillAndExpand" />

            <!-- Напис SIMPLE WAY -->
            <Grid HorizontalOptions="Center"
                  VerticalOptions="Start"
                  Margin="0,150,0,0">
                <!-- Контур -->
                <Label Text="SIMPLE WAY"
                       FontSize="70"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       TextColor="Red"
                       Padding="1,1,1,1" />

                <!-- Текст -->
                <Label Text="SIMPLE WAY"
                       FontSize="70"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       TextColor="White" />
            </Grid>

            <!-- Кнопка Розпочати подорож -->
            <Button x:Name="StartButton"
                    Text="Розпочати подорож"
                    BackgroundColor="LightGray"
                    TextColor="Black"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="250"
                    HeightRequest="100"
                    CornerRadius="20"
                    Clicked="OnStartButtonClicked">
                <Button.Triggers>
                    <Trigger TargetType="Button" Property="IsPressed" Value="True">
                        <Setter Property="Scale" Value="1.1" />
                    </Trigger>
                </Button.Triggers>
            </Button>

            <!-- Кнопка адміністратора (шестерня) -->
            <Button x:Name="AdminButton"
                    Text="⚙"
                    FontSize="24"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    WidthRequest="70"
                    HeightRequest="50"
                    Clicked="OnAdminButtonClicked" 
                    IsVisible="True" />


            <!-- Блок новин -->
            <Frame BackgroundColor="White"
                   Padding="10"
                   CornerRadius="10"
                   HorizontalOptions="Start"
                   VerticalOptions="End"
                   WidthRequest="300"
                   HeightRequest="350"
                   Opacity="0.8"
                   Margin="10">
                <StackLayout>
                    <Label Text="Новини з України"
                           HorizontalOptions="CenterAndExpand"
                           FontAttributes="Bold"
                           FontSize="18"
                           TextColor="Black" />

                    <Label Text="{Binding CurrentNews.Title}"
                           FontSize="14"
                           TextColor="Black"
                           FontAttributes="Bold" />

                    <Label Text="{Binding CurrentNews.Description}"
                           FontSize="12"
                           TextColor="Black" />

                    <Label Text="{Binding CurrentNews.Source}"
                           FontSize="10"
                           TextColor="Black"
                           FontAttributes="Italic"
                           HorizontalOptions="End" />

                    <!-- Індикатор для перемикання між новинами -->
                    <IndicatorView x:Name="NewsIndicator"
                                  IndicatorColor="Gray"
                                  SelectedIndicatorColor="Black"
                                  HorizontalOptions="CenterAndExpand"
                                  VerticalOptions="EndAndExpand"
                                  IndicatorSize="10"
                                  Count="{Binding NewsCount}"
                                  Position="{Binding CurrentNewsIndex, Mode=TwoWay}" />
                </StackLayout>
            </Frame>

            <!-- Блок часу і місцезнаходження праворуч -->
            <Frame BackgroundColor="White"
                   Padding="10"
                   CornerRadius="10"
                   HorizontalOptions="End"
                   VerticalOptions="End"
                   WidthRequest="100"
                   HeightRequest="100"
                   Opacity="0.8"
                   Margin="10">
                <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Київ"
                           FontAttributes="Bold"
                           FontSize="20"
                           TextColor="Black"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                    <Label Text="{Binding CurrentTime}"
                           FontSize="18"
                           TextColor="Black"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </StackLayout>
            </Frame>

        </Grid>

        <!-- Вікно авторизації адміністратора -->
        <Grid x:Name="AdminLoginPopup" IsVisible="False" BackgroundColor="#80000000">
            <Frame BackgroundColor="White" CornerRadius="10" Padding="20" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="300">
                <StackLayout>
                    <Label Text="Вхід для адміністратора" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" />
                    <Entry x:Name="AdminLoginEntry" Placeholder="Логін" TextColor="Black"/>
                    <Entry x:Name="AdminPasswordEntry" Placeholder="Пароль" IsPassword="True" TextColor="Black"/>
                    <Button Text="Увійти" Clicked="OnAdminLoginClicked" BackgroundColor="LightGray" TextColor="Black" />
                    <Button Text="Скасувати" Clicked="OnAdminCancelClicked" BackgroundColor="Transparent" TextColor="Black" />
                </StackLayout>
            </Frame>
        </Grid>

        <Grid x:Name="AdminInterface" IsVisible="False" Padding="20">
            <StackLayout Orientation="Vertical"
             HorizontalOptions="StartAndExpand"
             VerticalOptions="FillAndExpand"
             Margin="0,10,0,10"
             Spacing="10"
             WidthRequest="500">
                <!-- Напис над списком -->
                <Label Text="Список маршрутів" 
           FontSize="24" 
           FontAttributes="Bold" 
           HorizontalOptions="Start" 
           VerticalOptions="Start" />

                <!-- Таблиця маршрутів -->
                <CollectionView x:Name="RoutesCollectionView"
                                ItemsSource="{Binding DisplayedRoutes}"
                                SelectionMode="Single"
                                VerticalOptions="FillAndExpand"
                                HorizontalOptions="FillAndExpand"
                                Margin="0,10,0,0"
                                BackgroundColor="Transparent">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Padding="5">
                                <!-- Опис маршруту -->
                                <Label Text="{Binding Description}" 
                                        FontSize="16" 
                                        VerticalOptions="Center" 
                                        Grid.Column="0" />
                                <!-- Тип транспорту -->
                                <Label Text="{Binding TransportType}" 
                                        FontSize="14" 
                                        VerticalOptions="Center" 
                                        Grid.Column="1" />
                                <!-- Назва міста
                                <Label Text="{Binding CityName}" 
                                        FontSize="14" 
                                        VerticalOptions="Center" 
                                        Grid.Column="3" -->
                                <!-- Знак оклику, якщо дані відсутні -->
                                <Label Text="❗"
                                        FontSize="18"
                                        TextColor="Red"
                                        VerticalOptions="Center"
                                        HorizontalOptions="Center"
                                        IsVisible="{Binding HasMissingData}"
                                        Grid.Column="2" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </StackLayout>

            <!-- Фільтр за містом -->
            <StackLayout Orientation="Vertical"
                        HorizontalOptions="Center"
                        VerticalOptions="Start"
                        Margin="150,10,0,10">
                <Label Text="Оберіть місто:" 
                       FontSize="16" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" />
                <Picker x:Name="CityPicker"
                        Title="Натисніть щоб обрати місто"
                        SelectedIndexChanged="OnCityFilterChanged"
                        HorizontalOptions="Center"
                        VerticalOptions="Start">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>Всі</x:String>
                            <x:String>Київ</x:String>
                            <x:String>Львів</x:String>
                            <x:String>Херсон</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </StackLayout>

            <!-- Поля для введення інформації про маршрут -->
            <StackLayout Orientation="Vertical" HorizontalOptions="End" VerticalOptions="FillAndExpand" Margin="10" WidthRequest="300">

                <!-- Загальні поля маршруту -->
                <Frame x:Name="CityNameFrame" Padding="0" BorderColor="Transparent" CornerRadius="5">
                    <Entry x:Name="CityNameEntry" Placeholder="Назва міста" TextChanged="OnFieldTextChanged"/>
                </Frame>

                <Frame x:Name="RouteNumberFrame" Padding="0" BorderColor="Transparent" CornerRadius="5">
                    <Entry x:Name="RouteNumberEntry" Placeholder="Номер маршруту" TextChanged="OnFieldTextChanged"/>
                </Frame>

                <Frame x:Name="DescriptionFrame" Padding="0" BorderColor="Transparent" CornerRadius="5">
                    <Entry x:Name="DescriptionEntry" Placeholder="Опис маршруту" TextChanged="OnFieldTextChanged"/>
                </Frame>

                <Frame x:Name="DetailsFrame" Padding="0" BorderColor="Transparent" CornerRadius="5">
                    <Entry x:Name="DetailsEntry" Placeholder="Деталі маршруту" TextChanged="OnFieldTextChanged"/>
                </Frame>

                <Frame x:Name="RouteLengthFrame" Padding="0" BorderColor="Transparent" CornerRadius="5">
                    <Entry x:Name="RouteLengthEntry" Placeholder="Довжина маршруту (км)" Keyboard="Numeric" TextChanged="OnFieldTextChanged"/>
                </Frame>

                <Frame x:Name="StopCountFrame" Padding="0" BorderColor="Transparent" CornerRadius="5">
                    <Entry x:Name="StopCountEntry" Placeholder="Кількість зупинок" Keyboard="Numeric" TextChanged="OnFieldTextChanged"/>
                </Frame>

                <Frame x:Name="VehicleCountFrame" Padding="0" BorderColor="Transparent" CornerRadius="5">
                    <Entry x:Name="VehicleCountEntry" Placeholder="Кількість транспорту" Keyboard="Numeric" TextChanged="OnFieldTextChanged"/>
                </Frame>

                <Frame x:Name="IntervalFrame" Padding="0" BorderColor="Transparent" CornerRadius="5">
                    <Entry x:Name="IntervalEntry" Placeholder="Інтервал транспорту" TextChanged="OnFieldTextChanged"/>
                </Frame>

                <Frame x:Name="TransportTypeFrame" Padding="0" BorderColor="Transparent" CornerRadius="5">
                    <Entry x:Name="TransportTypeEntry" Placeholder="Тип транспорту" TextChanged="OnFieldTextChanged"/>
                </Frame>

                <!-- Вибір зупинки -->
                <Frame x:Name="StopPickerFrame" Padding="0" BorderColor="Transparent" CornerRadius="5">
                    <Picker x:Name="StopPicker"
            Title="Оберіть зупинку"
            SelectedIndexChanged="OnStopPickerSelectionChanged"
            HorizontalOptions="FillAndExpand" />
                </Frame>

                <!-- Поля для введення зупинки -->
                <Frame x:Name="StopNameFrame" Padding="5" BorderColor="Transparent" CornerRadius="5">
                    <Entry x:Name="StopNameEntry"
           Placeholder="Назва зупинки"
           IsEnabled="False"
           HorizontalOptions="FillAndExpand" />
                </Frame>

                <Frame x:Name="LatitudeFrame" Padding="5" BorderColor="Transparent" CornerRadius="5">
                    <Entry x:Name="LatitudeEntry"
           Placeholder="Широта"
           IsEnabled="False"
           HorizontalOptions="FillAndExpand" />
                </Frame>

                <Frame x:Name="LongitudeFrame" Padding="5" BorderColor="Transparent" CornerRadius="5">
                    <Entry x:Name="LongitudeEntry"
           Placeholder="Довгота"
           IsEnabled="False"
           HorizontalOptions="FillAndExpand" />
                </Frame>


                <!-- Кнопка збереження координат -->
                <Button x:Name="SaveCoordinatesButton"
            Text="Зберегти координати"
            IsEnabled="False"
            Clicked="OnSaveCoordinatesClicked" />

                <!-- Кнопки дій -->
                <Button Text="Додати/Оновити маршрут"
            Clicked="OnAddOrUpdateRouteClicked"
            BackgroundColor="LightGray"
            Margin="10" />

                <Button Text="Редагувати"
            Clicked="OnEditRouteClicked"
            BackgroundColor="LightGray"
            Margin="10" />

                <Button Text="Видалити"
            Clicked="OnDeleteRouteClicked"
            BackgroundColor="Red"
            Margin="10" />

            </StackLayout>

            <!-- Кнопки управління -->
            <StackLayout Orientation="Horizontal" HorizontalOptions="Center" VerticalOptions="End" Margin="10">
                <!--Button Text="Зберегти зміни"
                x:Name="SaveChangesButton"
                Clicked="OnSaveChangesClicked"
                IsEnabled="False"
                BackgroundColor="LightGray"
                TextColor="Black"
                Margin="10"
                WidthRequest="150" -->
                <Button Text="Вийти з режиму адміністратора"
                x:Name="ExitAdminModeButton"
                Clicked="OnExitAdminModeClicked"
                BackgroundColor="Red"
                TextColor="White"
                Margin="10"
                WidthRequest="250" />
                <Button Text="Скидання змін"
                x:Name="ResetChangesButton"
                Clicked="OnResetChangesClicked"
                BackgroundColor="LightGray"
                TextColor="Black"
                Margin="10"
                WidthRequest="170" />
            </StackLayout>

        </Grid>

        <!-- Інтерфейс з картою -->
        <Grid x:Name="MapInterface" IsVisible="False">
            <!-- Заднє розмите зображення -->
            <Image x:Name="BlurredBackground"
           Source="background2.png"
           Aspect="AspectFill"
           HorizontalOptions="FillAndExpand"
           VerticalOptions="FillAndExpand" />

            <!-- Інтерфейс із картою в AbsoluteLayout -->
            <AbsoluteLayout>
                <!-- Поля вводу місця відправлення та прибуття -->
                <Grid AbsoluteLayout.LayoutBounds="0.5,0.05,0.9,-1"
                      AbsoluteLayout.LayoutFlags="XProportional,WidthProportional"
                      RowDefinitions="Auto,Auto,Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,*">
                        <StackLayout Grid.Column="0" Padding="10">
                            <Label Text="Місце відправлення:"
                                   FontAttributes="Bold"
                                    FontSize="14"
                                    TextColor="White" />
                            <Entry x:Name="StartPointEntry"
                                    Placeholder="Введіть адресу відправлення"
                                    FontSize="16"
                                    BackgroundColor="White"
                                    TextColor="Black"
                                    IsEnabled="{Binding IsCitySelected}" />
                        </StackLayout>
                        <StackLayout Grid.Column="1" Padding="10">
                            <Label Text="Місце прибуття:"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    TextColor="White" />
                            <Entry x:Name="DestinationPointEntry"
                                    Placeholder="Введіть адресу прибуття"
                                    FontSize="16"
                                    BackgroundColor="White"
                                    TextColor="Black"
                                    IsEnabled="{Binding IsCitySelected}" />
                        </StackLayout>
                    </Grid>
                </Grid>

                <!-- Кнопка для додавання мітки місця відправлення -->
                <Button Text="◉"
                BackgroundColor="LightGray"
                TextColor="Black"
                WidthRequest="50"
                HeightRequest="40"
                CornerRadius="5"
                Clicked="OnAddStartPointMarkerClicked"
                AbsoluteLayout.LayoutBounds="0.01,0.047,50,40"
                AbsoluteLayout.LayoutFlags="XProportional,YProportional" />

                <!-- Кнопка для додавання мітки місця прибуття -->
                <Button Text="◉"
                BackgroundColor="LightGray"
                TextColor="Black"
                WidthRequest="50"
                HeightRequest="40"
                CornerRadius="5"
                Clicked="OnAddDestinationPointMarkerClicked"
                AbsoluteLayout.LayoutBounds="0.99,0.047,50,40"
                AbsoluteLayout.LayoutFlags="XProportional,YProportional" />

                <!-- Поле для введення міста -->
                <StackLayout AbsoluteLayout.LayoutBounds="0.5,90,300,-1"
                             AbsoluteLayout.LayoutFlags="XProportional"
                             BackgroundColor="Transparent">
                    <Label Text="Введіть назву міста:"
                            FontAttributes="Bold"
                            FontSize="14"
                            TextColor="White"
                            HorizontalOptions="Center" />
                    <Entry x:Name="CityEntry"
                            Placeholder="Введіть назву міста вручну"
                            TextChanged="OnCityEntryTextChanged"
                            FontSize="16"
                            BackgroundColor="White"
                            TextColor="Black"
                            WidthRequest="300"
                            HorizontalOptions="Center" />
                </StackLayout>

                <!-- Список підказок -->
                <Frame x:Name="CitySuggestionsParent"
                        IsVisible="{Binding FilteredCities.Count, Converter={StaticResource GreaterThanZeroConverter}}"
                        BackgroundColor="White"
                        Padding="0"
                        HasShadow="True"
                        CornerRadius="5"
                        AbsoluteLayout.LayoutBounds="0.5,155,300,300"
                        AbsoluteLayout.LayoutFlags="XProportional"
                        ZIndex="10">
                    <CollectionView x:Name="CitySuggestions"
                                    ItemsSource="{Binding FilteredCities}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnCitySelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="10">
                                    <StackLayout>
                                        <Label Text="{Binding .}" 
                                                FontSize="14" 
                                                TextColor="Black" />
                                        <Label Text="(Наразі недоступно)" 
                                                FontSize="12"
                                                FontAttributes="Italic"
                                                TextColor="Gray"
                                                IsVisible="{Binding ., Converter={StaticResource AvailabilityConverter}}" />
                                    </StackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Frame>

                <BoxView BackgroundColor="Transparent"
                            InputTransparent="False"
                            IsVisible="{Binding FilteredCities.Count, Converter={StaticResource GreaterThanZeroConverter}}"
                            AbsoluteLayout.LayoutBounds="0.5,0.5,1,1"
                            AbsoluteLayout.LayoutFlags="All">
                    <BoxView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTapGestureRecognizerTapped" />
                    </BoxView.GestureRecognizers>
                </BoxView>

                <!-- Кнопка -->
                <Button Text="Побудувати маршрут"
                        BackgroundColor="LightGray"
                        TextColor="Black"
                        AbsoluteLayout.LayoutBounds="0.5,160,200,50"
                        AbsoluteLayout.LayoutFlags="XProportional"
                        Clicked="OnBuildRouteClicked" />

                <!-- Нижня частина з Grid: список маршрутів і карта -->
                <Grid AbsoluteLayout.LayoutBounds="0.5,0.95,0.98,0.67"
                        AbsoluteLayout.LayoutFlags="All"
                        ColumnDefinitions="*,2*">
                    <!-- Список маршрутів -->
                    <StackLayout Grid.Column="0" BackgroundColor="#E8E8E8">
                        <Label Text="Список маршрутів"
                       FontAttributes="Bold"
                       FontSize="18"
                       HorizontalOptions="Center"
                       Margin="0,10" />
                        <CollectionView x:Name="RoutesListView"
                                ItemsSource="{Binding FilteredRoutes}"
                                SelectionMode="Single"
                                HeightRequest="400"
                                VerticalOptions="FillAndExpand">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <StackLayout Padding="5">
                                        <!--Label Text="{Binding RouteNumber}" FontAttributes="Bold" -->
                                        <Label Text="{Binding Description}" TextColor="Black" FontSize="14" />
                                        <Label Text="{Binding TransportType}" TextColor="Black" FontSize="12" />
                                    </StackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>

                    <!-- Карта -->
                    <WebView x:Name="MapWebView"
                     Source="map.html"
                     Grid.Column="1"
                     VerticalOptions="FillAndExpand"
                     HorizontalOptions="FillAndExpand" />
                </Grid>
            </AbsoluteLayout>
        </Grid>
    </Grid>
</ContentPage>